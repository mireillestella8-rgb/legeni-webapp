apiVersion: apps/v1
kind: Deployment
metadata:
  name: legeni-webapp
  namespace: {{ k8s_namespace }}
  labels:
    app: legeni-webapp
spec:
  replicas: {{ app_replicas }}
  revisionHistoryLimit: 5
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0
      maxSurge: 1
  selector:
    matchLabels:
      app: legeni-webapp
  template:
    metadata:
      labels:
        app: legeni-webapp
    spec:
      containers:
        - name: web
          image: {{ app_image }}
          imagePullPolicy: {{ app_image_pull_policy }}
          ports:
            - containerPort: 5000
          env:
            - name: APP_VERSION
              value: "{{ app_version }}"
            - name: APP_ENV
              value: "{{ target_env }}"
            - name: APP_COLOR
              value: "{{ app_color }}"
            - name: REDIS_HOST
              value: redis
            - name: REDIS_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: redis-secret
                  key: REDIS_PASSWORD
          readinessProbe:
            httpGet:
              path: /ready
              port: 5000
            initialDelaySeconds: 3
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /health
              port: 5000
            initialDelaySeconds: 10
            periodSeconds: 10
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 200m
              memory: 128Mi
---
apiVersion: v1
kind: Service
metadata:
  name: legeni-webapp
  namespace: {{ k8s_namespace }}
spec:
  type: NodePort
  selector:
    app: legeni-webapp
  ports:
    - port: 80
      targetPort: 5000
      nodePort: {{ app_node_port }}
